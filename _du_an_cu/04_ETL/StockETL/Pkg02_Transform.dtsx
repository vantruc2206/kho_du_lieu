                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT symbol, exchange, industry, ecosystem, organ_name
FROM (
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY UPPER(LTRIM(RTRIM(symbol)))
               ORDER BY LoadDate DESC
           ) AS rn
    FROM dbo.StgStocks
    WHERE symbol IS NOT NULL
) AS x
WHERE rn = 1;</property>
